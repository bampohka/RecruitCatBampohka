@page
@model OurTeamModel
@{
    ViewData["Title"] = "Our Team";
}

<!-- ================= TEAM HERO ================= -->
<section class="team-hero text-center">
    <div class="container">
        <div class="section-eyebrow">The People Behind Job Bro</div>
        <h1 class="fw-bold mt-2">Meet Our Founding Team</h1>
        <p class="text-light-70 mx-auto mt-3" style="max-width:650px;">
            Job Bro was built by three co-founders who each bring a different piece of what it takes
            to run a modern HR and recruiting firm: people, operations, and technology.
        </p>
    </div>
</section>

<!-- ================= TEAM GRID ================= -->
<section class="bg-soft">
    <div class="container">
        <div class="row g-4">

            <!-- Kofi Bampoh -->
            <div class="col-md-6 col-lg-4">
                <div class="team-card">
                    <img src="~/images/team/kofi-bampoh.jpg" alt="Portrait of Kofi Bampoh, Co-Founder and CEO of Job Bro" />
                    <div class="team-card-body">
                        <h4 class="team-name">Kofi Bampoh</h4>
                        <div class="team-role">Co-Founder &amp; Chief Executive Officer</div>
                        <p class="team-bio">
                            Kofi Bampoh is a Co-Founder and CEO of Job Bro, where he leads the company's
                            overall vision and strategic direction. With a background in workforce development
                            and business operations, Kofi has dedicated his career to helping organizations
                            build stronger, more capable teams. He works closely with clients across healthcare,
                            manufacturing, and technology to design recruiting strategies that fit their unique
                            hiring challenges. Outside of Job Bro, Kofi enjoys mentoring young professionals
                            entering the HR and talent acquisition field.
                        </p>
                        <div class="team-socials mt-3">
                            <a href="#" aria-label="Kofi's LinkedIn"><i class="bi bi-linkedin"></i></a>
                            <a href="#" aria-label="Email Kofi"><i class="bi bi-envelope-fill"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- James Biggs -->
            <div class="col-md-6 col-lg-4">
                <div class="team-card">
                    <img src="~/images/team/james-biggs.jpg" alt="Portrait of James Biggs, Co-Founder and COO of Job Bro" />
                    <div class="team-card-body">
                        <h4 class="team-name">James Biggs</h4>
                        <div class="team-role">Co-Founder &amp; Chief Operating Officer</div>
                        <p class="team-bio">
                            James Biggs serves as Co-Founder and Chief Operating Officer of Job Bro, overseeing
                            the day-to-day operations that keep the company's recruiting engine running smoothly.
                            He brings over a decade of experience in logistics and supply chain staffing, having
                            managed large-scale workforce placements for distribution and manufacturing clients.
                            James is known for streamlining processes and building systems that let the Job Bro
                            team scale without losing its personal touch. When he's not optimizing operations,
                            he enjoys coaching youth basketball in his local community.
                        </p>
                        <div class="team-socials mt-3">
                            <a href="#" aria-label="James's LinkedIn"><i class="bi bi-linkedin"></i></a>
                            <a href="#" aria-label="Email James"><i class="bi bi-envelope-fill"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Jenny Hose -->
            <div class="col-md-6 col-lg-4">
                <div class="team-card">
                    <img src="~/images/team/jenny-hose.jpg" alt="Portrait of Jenny Hose, Co-Founder and CIO of Job Bro" />
                    <div class="team-card-body">
                        <h4 class="team-name">Jenny Hose</h4>
                        <div class="team-role">Co-Founder &amp; Chief Information Officer</div>
                        <p class="team-bio">
                            Jenny Hose is Co-Founder and Chief Information Officer at Job Bro, responsible for
                            the technology and data systems behind the company's recruiting platform. She has a
                            strong background in software development and analytics, and she's focused on making
                            the job-matching process faster and more accurate for both clients and candidates.
                            Jenny leads the team that built Job Bro's online application portal, ensuring it's
                            simple enough for any job seeker to use. She's especially interested in how data can
                            help predict the right fit between a candidate and a company long before the first
                            interview.
                        </p>
                        <div class="team-socials mt-3">
                            <a href="#" aria-label="Jenny's LinkedIn"><i class="bi bi-linkedin"></i></a>
                            <a href="#" aria-label="Email Jenny"><i class="bi bi-envelope-fill"></i></a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ================= WHY THREE FOUNDERS ================= -->
<section class="bg-navy">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <h2 class="fw-bold">Three founders, one focus: getting hiring right.</h2>
                <p class="text-light-70 mt-3 mb-0">
                    We built Job Bro around the belief that great staffing takes more than a resume database.
                    It takes people who understand operations, technology that keeps the process fast and fair,
                    and leadership that stays close to every client relationship. That's the balance our
                    founding team was built to strike.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end text-center">
                <a asp-area="" asp-page="/Index" class="btn btn-accent btn-lg px-5">Back to Home</a>
            </div>
        </div>
    </div>
</section>
