<!-- ================= APPLY PROCESS ================= -->
<section class="bg-soft" id="apply" style="background-color:#EFF2F7;">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-eyebrow">For Job Seekers</div>
            <h2 class="section-title mt-2">How to apply, start to finish</h2>
            <p class="text-muted mx-auto" style="max-width:650px;">
                Our entire application process happens online, so you can get started in minutes
                from any device.
            </p>
        </div>
        <div class="row g-4">
            <div class="col-md-4 col-lg-2">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <h6>Create a Profile</h6>
                    <p class="small text-muted mb-0">Sign up on our site and upload your resume in under five minutes.</p>
                </div>
            </div>
            <div class="col-md-4 col-lg-2">
                <div class="step-card">
                    <div class="step-number">2</div>
                    <h6>Tell Us Your Goals</h6>
                    <p class="small text-muted mb-0">Set your target industry, location, and pay expectations.</p>
                </div>
            </div>
            <div class="col-md-4 col-lg-2">
                <div class="step-card">
                    <div class="step-number">3</div>
                    <h6>Get Matched</h6>
                    <p class="small text-muted mb-0">Our recruiters match your profile to open roles that fit.</p>
                </div>
            </div>
            <div class="col-md-4 col-lg-2">
                <div class="step-card">
                    <div class="step-number">4</div>
                    <h6>Interview</h6>
                    <p class="small text-muted mb-0">We prep you and schedule interviews directly with employers.</p>
                </div>
            </div>
            <div class="col-md-4 col-lg-2">
                <div class="step-card">
                    <div class="step-number">5</div>
                    <h6>Receive an Offer</h6>
                    <p class="small text-muted mb-0">We help you review and negotiate before you sign anything.</p>
                </div>
            </div>
            <div class="col-md-4 col-lg-2">
                <div class="step-card">
                    <div class="step-number">6</div>
                    <h6>Start Strong</h6>
                    <p class="small text-muted mb-0">We check in through your first 90 days on the job.</p>
                </div>
            </div>
        </div>
        <div class="text-center mt-5">
            <a href="#" class="btn btn-accent btn-lg px-5">Create Your Free Profile</a>
        </div>
    </div>
</section>


<!-- ================= CTA / MEET THE TEAM TEASER ================= -->
<section class="bg-navy">
    <div class="container text-center">
        <h2 class="fw-bold">Want to know who you'll be working with?</h2>
        <p class="text-light-70 mx-auto mb-4" style="max-width:600px;">
            Meet the founders behind Job Bro and the experience they bring to every placement.
        </p>

        <a href="/OurTeam" class="btn btn-accent btn-lg px-5">
            Meet Our Team
        </a>

    </div>
</section>





