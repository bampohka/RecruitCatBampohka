@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<!-- ================= HERO ================= -->
<section class="hero" style="--hero-img: url('https://picsum.photos/seed/jobbro-hero/1600/900');">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge bg-light text-navy px-3 py-2 mb-3" style="color:#0B2545; font-weight:600;">
                    <i class="bi bi-award-fill me-1" style="color:#E3A61B;"></i> Trusted by 120+ companies across Texas
                </span>
                <h1>We connect great people with the companies that need them.</h1>
                <p class="lead mt-3">
                    Job Bro is a professional HR and talent solutions firm delivering recruitment, staffing,
                    and human resource support to organizations across diverse industries. We help businesses
                    build high&#8209;performing teams by connecting them with skilled professionals, optimizing
                    workforce processes, and providing strategic HR guidance that drives sustainable growth.
                </p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a href="#apply" class="btn btn-accent btn-lg px-4">Find Your Next Role</a>
                    <a href="#contact" class="btn btn-outline-light btn-lg px-4">Hire With Job Bro</a>
                </div>

                <div class="row hero-stats gy-3">
                    <div class="col-4">
                        <div class="stat-number">2,400+</div>
                        <div class="small text-light-70">Candidates Placed</div>
                    </div>
                    <div class="col-4">
                        <div class="stat-number">120+</div>
                        <div class="small text-light-70">Partner Employers</div>
                    </div>
                    <div class="col-4">
                        <div class="stat-number">5</div>
                        <div class="small text-light-70">Industries Served</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= SERVICES ================= -->
<section class="bg-soft" id="services">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-eyebrow">What We Do</div>
            <h2 class="section-title mt-2">Recruiting and HR support built around your business</h2>
            <p class="text-muted mx-auto" style="max-width:650px;">
                With a commitment to excellence, integrity, and innovation, Job Bro partners with companies
                of all sizes;from startups to large enterprises;to meet their evolving workforce
                needs in a competitive market.
            </p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="jb-card">
                    <div class="jb-icon-circle"><i class="bi bi-person-badge"></i></div>
                    <h5>Permanent Recruitment</h5>
                    <p class="text-muted mb-0">
                        We source, screen, and place full-time professionals who fit both the role and
                        your company culture..
                    </p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="jb-card">
                    <div class="jb-icon-circle"><i class="bi bi-clock-history"></i></div>
                    <h5>Temporary &amp; Contract Staffing</h5>
                    <p class="text-muted mb-0">
                        Scale your workforce up or down for seasonal demand, special projects, or coverage
                        gaps.
                    </p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="jb-card">
                    <div class="jb-icon-circle"><i class="bi bi-diagram-3"></i></div>
                    <h5>Workforce Optimization</h5>
                    <p class="text-muted mb-0">
                        We audit your hiring pipeline and staffing structure, then recommend process
                        improvements that reduce cost-per-hire.
                    </p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="jb-card">
                    <div class="jb-icon-circle"><i class="bi bi-lightbulb"></i></div>
                    <h5>Strategic HR Guidance</h5>
                    <p class="text-muted mb-0">
                        From compensation benchmarking to onboarding design, our consultants help you
                        build HR practices that scale with sustainable growth.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= INDUSTRIES ================= -->
<section class="bg-navy" id="industries">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-eyebrow">Where We Specialize</div>
            <h2 class="mt-2 fw-bold">Industries we know inside and out</h2>
            <p class="text-light-70 mx-auto" style="max-width:650px;">
                Deep sector experience means we already understand the roles, credentials, and pace
                your industry demands.
            </p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="industry-card">
                    <img src="https://picsum.photos/seed/jobbro-healthcare/600/450" alt="Healthcare worker in a clinical setting" loading="lazy" />
                    <div class="industry-overlay">
                        <h5>Healthcare &amp; Medical Services</h5>
                        <p>Hospitals, clinics, pharmacies, laboratories, diagnostic centers, home&#8209;care providers.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="industry-card">
                    <img src="https://picsum.photos/seed/jobbro-manufacturing/600/450" alt="Manufacturing plant floor" loading="lazy" />
                    <div class="industry-overlay">
                        <h5>Manufacturing &amp; Industrial</h5>
                        <p>Factories, production plants, assembly lines, quality control, maintenance teams.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                 <div class="industry-card">
                    <img src="https://picsum.photos/seed/jobbro-construction/600/450" alt="Construction site" loading="lazy" />
                    <div class="industry-overlay">
                        <h5>Construction &amp; Engineering</h5>
                        <p>Civil works, building contractors, technical engineering roles, project sites.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="industry-card">
                    <img src="https://picsum.photos/seed/jobbro-technology/600/450" alt="Technology and IT professionals at work" loading="lazy" />
                    <div class="industry-overlay">
                        <h5>Technology &amp; IT Services</h5>
                        <p>Software development, IT support, cybersecurity, data analytics, tech startups.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="jb-card h-100 d-flex flex-column justify-content-center text-center" style="background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.1);">
                    <i class="bi bi-arrow-right-circle text-accent fs-1 mb-2"></i>
                    <h5 class="text-white">Don't see your industry?</h5>
                    <p class="text-light-70 mb-3">We regularly place candidates outside these core sectors too.</p>
                    <a href="#contact" class="btn btn-outline-accent">Talk to Us</a>
                </div>
            </div>
        </div>
    </div>
</section>

