@page  "{id:int}"
@model homework.Pages.CandidatePages.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Candidate - @Model.Candidate.FirstName @Model.Candidate.LastName</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Candidate</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.FirstName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.FirstName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.LastName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.LastName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.TargetSalary)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.TargetSalary)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.PhoneNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.PhoneNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.YearsOfExperince)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.YearsOfExperince)
        </dd>
        <dt class = "col-sm-2">
            Company
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.Company.Name)
        </dd>
        <dt class = "col-sm-2">
            Job Title
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.JobTitle.Title)
        </dd>
        <dt class = "col-sm-2">
            Industry
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.Industry.Name)
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Candidate.CandidateId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>